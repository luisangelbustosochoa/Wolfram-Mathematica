Cell["\<\
VISUALIZACI\[CapitalOAcute]N  Y EXPLORACI\[CapitalOAcute]N 
\
\>", "Title",
 CellChangeTimes->{{4.002124158060747*^9, 4.002124193008196*^9}},
 CellID->837585612,ExpressionUUID->"81db9cf9-c536-407a-9de3-ece3980af147"],

Cell["\<\
Listas, tablas y gr\[AAcute]ficas
\
\>", "Subtitle",
 CellChangeTimes->{{4.002124220185775*^9, 4.002124229567931*^9}},
 CellID->1338992876,ExpressionUUID->"ec63776a-d705-4bc8-93d0-af4a2fce622b"],

Cell["\<\
una lista es {a,b,c}. Table[expresion, {tabla}] repite expresion variando x. \
Plot[f,{tabla}]. Graficar funciones; ListPlot[tabla, PlotStyle->{Red, \
PointSize[0.02]}] grafica puntos, Manipulate agrega controles para ver como \
cambia el resultado al varia par\[AAcute]metros. \
\>", "Text",
 CellChangeTimes->{{4.002124258907214*^9, 4.002124424480769*^9}},
 CellID->1374137780,ExpressionUUID->"d8767aa8-3f38-427f-a87a-58b71d997fac"],

