 RowBox[{"ysol", " ", "=", " ", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.3"}], " ", 
         RowBox[{"y", "[", "t", "]"}]}], " ", "+", " ", "2"}]}], ",", " ", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",", " ",
     "y", ",", " ", 
    RowBox[{"{", 
