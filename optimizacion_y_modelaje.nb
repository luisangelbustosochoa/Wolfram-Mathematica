        RowBox[{
         RowBox[{
          RowBox[{"2", " ", "x"}], " ", "+", " ", 
          RowBox[{"4", " ", "y"}]}], " ", "<=", " ", "h"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"60", " ", "x"}], " ", "+", " ", 
          RowBox[{"40", " ", "y"}]}], " ", "<=", " ", "2800"}], " ", "&&", 
        "\n", 
        RowBox[{"x", " ", ">=", " ", "0"}], " ", "&&", " ", 
        RowBox[{"y", " ", ">=", " ", "0"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", " ", 
     RowBox[{"utilidad", "[", "h", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"h", ",", " ", "130", ",", " ", "150", ",", " ", "10"}], "}"}]}], 
