Cell[BoxData[{
 RowBox[{
  RowBox[{"utilidad", "[", "h_", "]"}], " ", ":=", " ", 
  RowBox[{"First", "@", 
   RowBox[{"Maximize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"14000", " ", "x"}], " ", "+", " ", 
