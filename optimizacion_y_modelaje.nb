Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"restr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"3", " ", "x"}], "+", 
      RowBox[{"2", " ", "y"}]}], "\[LessEqual]", "120"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", "x"}], "+", 
      RowBox[{"4", " ", "y"}]}], "\[LessEqual]", "140"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"60", " ", "x"}], "+", 
      RowBox[{"40", " ", "y"}]}], "\[LessEqual]", "2800"}], "&&", 
    RowBox[{"x", "\[GreaterEqual]", "0"}], "&&", 
    RowBox[{"y", "\[GreaterEqual]", "0"}]}]}], ";"}], "\n", 
 RowBox[{"opt", "=", 
  RowBox[{"Maximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"14000", " ", "x"}], "+", 
       RowBox[{"16000", " ", "y"}]}], ",", "restr"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"120", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "x"}], "+", 
       RowBox[{"2", " ", "y"}]}], ")"}]}], ",", 
    RowBox[{"140", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "x"}], "+", 
       RowBox[{"4", " ", "y"}]}], ")"}]}], ",", 
    RowBox[{"2800", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"60", " ", "x"}], "+", 
       RowBox[{"40", " ", "y"}]}], ")"}]}]}], "}"}], "/.", 
  RowBox[{"opt", "[", 
   RowBox[{"[", "2", "]"}], "]"}]}], "\n", 
 RowBox[{"Maximize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"14000", " ", "x"}], "+", 
      RowBox[{"16000", " ", "y"}]}], ",", 
     RowBox[{"restr", "&&", 
      RowBox[{"Element", "[", 
       RowBox[{"x", ",", "Integers"}], "]"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{"y", ",", "Integers"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"utilidad", "[", "h_", "]"}], ":=", 
  RowBox[{"First", "@", 
   RowBox[{"Maximize", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"14000", " ", "x"}], "+", 
        RowBox[{"16000", " ", "y"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"3", " ", "x"}], "+", 
          RowBox[{"2", " ", "y"}]}], "\[LessEqual]", "120"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", "x"}], "+", 
          RowBox[{"4", " ", "y"}]}], "\[LessEqual]", "h"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"60", " ", "x"}], "+", 
          RowBox[{"40", " ", "y"}]}], "\[LessEqual]", "2800"}], "&&", 
        RowBox[{"x", "\[GreaterEqual]", "0"}], "&&", 
        RowBox[{"y", "\[GreaterEqual]", "0"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", ",", 
     RowBox[{"utilidad", "[", "h", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "130", ",", "150", ",", "10"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Maximize", "[", 
  RowBox[{
   RowBox[{"{", 
