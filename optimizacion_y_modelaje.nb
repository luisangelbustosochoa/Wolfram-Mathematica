Cell[BoxData[
 RowBox[{
  RowBox[{"leer", "[", "nombre_", "]"}], ":=", " ", 
  RowBox[{"Rest", "@", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"base", ",", "\"\<datos\>\"", ",", "nombre"}], "}"}], ",", 
         "\"\<CSV\>\""}], "]"}], "\n", "cal"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"leer", "[", "\"\<calibracion_sensor.csv\>\"", "]"}], "\n", 
        "lm"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"LinearModelFit", "[", 
          RowBox[{"cal", ",", "u", ",", "u"}], "]"}], "\n", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"lm", "[", "\"\<BestFitParameters\>\"", "]"}], "\n", 
          RowBox[{"lm", "[", "\"\<ParameterConfidenceIntervals\>\"", "]"}], 
          "\n", 
          RowBox[{"lm", "[", "\"\<RSquared\>\"", "]"}], "\n", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"lm", "[", "\"\<EstaimatedVariance\>\"", "]"}], "]"}], 
          "\n", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"lm", "[", "\"\<FitResiduals\>\"", "]"}], "]"}], "]"}], 
          "\n", 
          RowBox[{"corregir", "[", "s_", "]"}]}], ":=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s", "-", "a"}], ")"}], "/", "b"}], "\n", 
           RowBox[{"Corregir", "[", "55.5", "]"}], "\n", "enf"}], "=", 
          RowBox[{
          "lerr", "[", "\"\<enfriamiento-tanque.csv\>\"", "]"}]}]}]}]}]}], 
     ";", "\n", 
     RowBox[{"modelo", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ta", "+", 
         RowBox[{"dTExp", "[", 
          RowBox[{
           RowBox[{"-", "t"}], "/", "tau"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"tau", ",", "200"}], "}"}]}], "}"}]}], ";", "\n", 
     RowBox[{"aj1", "=", 
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"enf", ",", "modelo", ",", "inicio", ",", "t"}], "]"}]}], ";", 
     "\n", 
     RowBox[{"aj1", "[", "\"\<BestFitParameters\>\"", "]"}], "\n", ";", "\n", 
     
     RowBox[{"res", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"aj1", "[", "\"\<FitResiduals\>\"", "]"}], "\n", "sigR"}], 
       "=", 
       RowBox[{
        RowBox[{"1.482", 
         RowBox[{"MedianDeviation", "[", "res", "]"}], "\n", "mantener"}], 
        "=", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"res", "-", 
             RowBox[{"Median", "[", "res", "]"}]}], "]"}], ",", 
           RowBox[{"v_", "/;", 
            RowBox[{"v", "\[LessEqual]", 
             RowBox[{"3", " ", "sigR"}]}]}]}], "]"}]}]}]}]}], ";", "\n", 
     RowBox[{"quitados", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "enf", "]"}], "]"}], ",", " ", "mantener"}],
          "]"}], "\n", "aj2"}], " ", "=", " ", 
       RowBox[{"NonlinearModelFit", "[", 
        RowBox[{
         RowBox[{"enf", "[", 
          RowBox[{"[", "mantener", "]"}], "]"}], ",", " ", "modelo", ",", " ",
          "inicio", ",", " ", "t"}], "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{
       RowBox[{"aj2", "[", "\"\<ParameterTable\>\"", "]"}], "\n", 
       RowBox[{"aj2", "[", "300", "]"}], "\n", "tmedio"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"tau", " ", 
        RowBox[{"Log", "[", "2", "]"}]}], " ", "/.", " ", 
       RowBox[{
        RowBox[{"aj2", "[", "\"\<BestFitParameters\>\"", "]"}], "\n", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"ListPlot", "[", 
           RowBox[{"enf", ",", " ", 
            RowBox[{"PlotStyle", " ", "->", " ", "Black"}]}], "]"}], ",", 
          "\n", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"aj1", "[", "t", "]"}], ",", " ", 
              RowBox[{"aj2", "[", "t", "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "0", ",", " ", "600"}], "}"}], ",", " ", 
            RowBox[{"PlotStyle", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"Orange", ",", " ", "Green"}], "}"}]}]}], "]"}], ",", 
          "\n", 
          RowBox[{"AxesLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<t (s)\>\"", ",", " ", "\"\<T (C)\>\""}], "}"}]}]}], 
         "]"}], "\n"}]}]}]}]}]}]}]], "Code",
 CellChangeTimes->{{4.002383337194256*^9, 4.002383346079431*^9}, {
  4.002383376858864*^9, 4.002383424647509*^9}, {4.002383461929179*^9, 
  4.0023835207664347`*^9}, {4.002383564213489*^9, 4.002383660151919*^9}, {
  4.002383703622221*^9, 4.002383939046814*^9}, {4.0023839772223663`*^9, 
  4.0023839801982193`*^9}},ExpressionUUID->"3bef9b31-1b74-4d35-8105-\
a967e2f23063"],

Cell["\<\
bestfit parameters : encontar mejor parameter que se ajuste al modelo.
ParameterConfidenceIntervals: son los parametros de pendiente y constante, \
entre mas cercano entre ellos mejor. 
\
\>", "Text",
 CellChangeTimes->{{4.002383984396201*^9, 4.00238398822157*^9}, {
