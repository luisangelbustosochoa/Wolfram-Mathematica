Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global'*\>\"", "]"}], "\n", 
 RowBox[{"restr", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"3", "*", "x"}], "+", 
     RowBox[{"2", " ", "y"}]}], "\[LessEqual]", "120"}], " ", "&&", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "*", "x"}], "+", 
     RowBox[{"4", "*", "y", " ", "y"}]}], "\[LessEqual]", "140"}], " ", "&&", 
   " ", 
   RowBox[{
    RowBox[{
     RowBox[{"60", "*", "x"}], "+", 
     RowBox[{"40", "*", "y"}]}], "\[LessEqual]", " ", "2800"}], " ", "&&", 
   " ", 
   RowBox[{"x", "\[GreaterEqual]", "0"}], " ", "&&", " ", 
   RowBox[{"y", "\[GreaterEqual]", "0"}]}]}]}], "Code",
 CellChangeTimes->{{4.0023887919356833`*^9, 4.002388896248427*^9}, {
  4.002389308325099*^9, 4.00238930883768*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"6fbecbc6-8f74-4bcf-8ac1-dbac698a46f2"],

