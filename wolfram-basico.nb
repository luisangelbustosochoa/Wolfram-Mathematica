Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"z_", ",", "y_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"z", "*", "z"}], "+", 
   RowBox[{"y", "*", "z"}]}]}]], "Code",
 CellChangeTimes->{{4.002051337881454*^9, 4.00205137230472*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"e2cc3273-ebfa-441c-bd5b-1094f5d3e0f6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "^", "2"}], "+", 
      RowBox[{"y", "^", "2"}]}], "<", "1"}], "&&", 
    RowBox[{"y", ">", "x"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.0020512136367817`*^9, 4.002051221975148*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"660e4ae5-adb7-41e3-adce-f767c59e28e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "<", "x", "\[LessEqual]", 
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}]}], "&&", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox[
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]]}], "<", "y", "<", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]}]}], ")"}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       SqrtBox["2"]]}], "<", "x", "<", 
     FractionBox["1", 
      SqrtBox["2"]]}], "&&", 
    RowBox[{"x", "<", "y", "<", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.0020512229648438`*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"0dd83881-e433-4ca5-842f-fc84769aea12"]
}, Open  ]],

